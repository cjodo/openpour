{
  "name": "Pump + flow meter",
  "author": "OpenPour",
  "pins": ["PUMP", "OUT", "VCC", "GND"],
  "controls": [
    { "id": "gpsAtFull", "label": "Pump rate at full power (g/s)", "type": "range", "min": 0, "max": 12, "step": 0.1 },
    { "id": "pulsesPerLitre", "label": "Meter pulses per litre (real)", "type": "range", "min": 1000, "max": 3000, "step": 5 },
    { "id": "dry", "label": "Dry pump (1 = no water)", "type": "range", "min": 0, "max": 1, "step": 1 },
    { "id": "meterDead", "label": "Dead meter (1 = no pulses)", "type": "range", "min": 0, "max": 1, "step": 1 }
  ]
}
